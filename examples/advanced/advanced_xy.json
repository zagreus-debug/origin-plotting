{
  "data": "xy.csv",
  "figsize": [11, 5.5],
  "layout": {"rows": 1, "cols": 2},
  "suptitle": "Multi-panel, dual Y, inset, broken axis, nonlinear fit",
  "panels": [
    {
      "type": "xy",
      "series": [
        {
          "label": "A",
          "x": "time",
          "y": "A",
          "color": "#d62728",
          "marker": "o",
          "line": true,
          "fit": {
            "model": "exp_offset",
            "p0": [0.7, 0.05, 0.1],
            "label": "Fit A"
          }
        },
        {
          "label": "Right axis",
          "x": "time",
          "y": "right",
          "axis": "right",
          "color": "#1f77b4",
          "line": true
        }
      ],
      "xlabel": "time / s",
      "ylabel": "A",
      "right_ylabel": "R",
      "xlim": [0, 10],
      "xticks": [0, 2, 4, 6, 8, 10],
      "legend": {"loc": "lower right", "frame": true},
      "inset": {
        "type": "xy",
        "series": [
          {"label": "B", "x": "time", "y": "B", "color": "#2ca02c", "marker": "s"}
        ],
        "xlabel": "t",
        "ylabel": "B",
        "legend": {"show": false},
        "bounds": [0.62, 0.62, 0.3, 0.3]
      }
    },
    {
      "type": "xy",
      "series": [
        {
          "label": "B with band",
          "x": "time",
          "y": "B",
          "band": ["lo", "hi"],
          "color": "#2ca02c",
          "line": true,
          "band_alpha": 0.25
        }
      ],
      "broken": {"y": [0.40, 0.50]},
      "xlim": [0, 10],
      "ylim": [0, 0.9],
      "xlabel": "time / s",
      "ylabel": "B"
    }
  ]
}
